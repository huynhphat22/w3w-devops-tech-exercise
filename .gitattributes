# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly enforce LF line endings on scripts, configs, and source code
*.sh text eol=lf
*.bash text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf

# PowerShell scripts can be CRLF or LF (PowerShell handles both)
*.ps1 text eol=crlf
